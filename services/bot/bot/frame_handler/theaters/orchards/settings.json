{
    "version": "0.1",
    "id": "orchards",
    "billboard": "Huertas",
    "settings": {
        "display_galleries": true
    },
    "container": {
        "endpoint_path": "/container_frames/orchard"
    },
    "atrium": {
        "name": "atrium",
        "selfButtonLabel": "Ver Todas las Huertas",
        "frame": {
            "template": "with_cover",
            "data": {
                "cover": "img/atrium.png",
                "text_box": {
                    "title": "Huertas Activas",
                    "description": "Seleccione la huerta de tu interés"
                }
            },
            "query": {
                "key": "SQL_query",
                "value": "all"
            }
        }
    },
    "galleries": [
        {
            "name": "categories",
            "selfButtonLabel": "Categorías",
            "frame": {
                "template": "with_cover",
                "data": {
                    "cover": "img/categories.png",
                    "text_box": {
                        "title": "Categorías",
                        "description": "Por favor, seleccione una categoría para filtrar las huertas"
                    }
                },
                "query": {
                    "key": "SQL_query",
                    "value": "categories"
                }
            }
        }
    ]
}